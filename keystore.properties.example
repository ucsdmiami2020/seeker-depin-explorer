# Copy to android/keystore.properties AFTER `npx expo prebuild`. Never commit the real file.
# Generate the keystore once and back it up — losing it means you can never update the listing:
#   keytool -genkeypair -v -storetype PKCS12 -keystore keystores/dapp-store-release.jks \
#     -alias dappstore -keyalg RSA -keysize 4096 -validity 10000
storeFile=../../keystores/dapp-store-release.jks
storePassword=CHANGE_ME
keyAlias=dappstore
keyPassword=CHANGE_ME
